# Backend R0 accepts synthetic demo mode only; no provider key is needed.
# Default engine remains the deterministic stub. Provider-neutral investigator
# injection is documented in docs/product/ai-data-and-evaluation.md.
MARK1_MODE=demo
MARK1_DB=out/mark1.sqlite
# Generate a bearer token with: python -m mark1.server init
# Tokens are stored as hashes in SQLite, never in this example or the repository.
