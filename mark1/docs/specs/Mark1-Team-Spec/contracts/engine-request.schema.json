{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mark1:engine-request:1.0",
  "title": "EngineRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "based_on_revision": {
      "type": "integer",
      "minimum": 0
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "IDENTIFY",
        "NEXT_CHECK"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_identity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "configuration_id",
            "human_confirmed"
          ],
          "properties": {
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "configuration_id": {
              "type": "string",
              "minLength": 1
            },
            "human_confirmed": {
              "const": true
            }
          }
        }
      ]
    },
    "manual_label": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "cleared_images": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mime_type": {
            "enum": [
              "image/jpeg",
              "image/png"
            ]
          },
          "cleared_handle": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "image_id",
          "sha256",
          "mime_type",
          "cleared_handle"
        ]
      }
    },
    "approved_catalog": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:mark1:catalog:1.0",
      "title": "Approved scoped catalog",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "PREFLIGHT",
                  "OBSERVATION",
                  "EXTERNAL_CHECK"
                ]
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "workflow_id": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "safety_notice": {
                "type": "string",
                "minLength": 1
              },
              "stop_conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "observation_code": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stop_values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "check_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "check_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation_code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allowed_values": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "check_id",
                    "check_version",
                    "observation_code",
                    "allowed_values"
                  ]
                }
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rights_record_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source_id",
                  "version",
                  "sha256",
                  "title",
                  "locator",
                  "rights_record_id"
                ]
              },
              "state": {
                "const": "Approved"
              },
              "approval_record_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "check_id",
              "version",
              "kind",
              "model_id",
              "configuration_id",
              "workflow_id",
              "instruction",
              "safety_notice",
              "stop_conditions",
              "observation_code",
              "options",
              "stop_values",
              "prerequisites",
              "source",
              "state",
              "approval_record_id"
            ]
          }
        }
      },
      "required": [
        "catalog_version",
        "checks"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "check_version": {
            "type": "string",
            "minLength": 1
          },
          "observation_code": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "const": "HUMAN_CONFIRMED"
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "check_version",
          "observation_code",
          "value",
          "provenance",
          "record_id"
        ]
      }
    },
    "completed_check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remaining_budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "turns",
        "calls",
        "deadline_at"
      ]
    },
    "model_config_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "session_id",
    "based_on_revision",
    "context_hash",
    "mode",
    "workflow_id",
    "confirmed_identity",
    "manual_label",
    "cleared_images",
    "approved_catalog",
    "observations",
    "completed_check_ids",
    "remaining_budgets",
    "model_config_version",
    "prompt_version",
    "catalog_version"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "NEXT_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "confirmed_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model_id",
              "configuration_id",
              "human_confirmed"
            ],
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "human_confirmed": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "confirmed_identity": {
            "type": "null"
          }
        }
      }
    }
  ]
}
