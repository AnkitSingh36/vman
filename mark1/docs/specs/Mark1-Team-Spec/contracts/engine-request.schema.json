{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mark1.invalid/v2/engine-request.schema.json",
  "title": "EngineRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "based_on_revision": {
      "type": "integer",
      "minimum": 0
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "IDENTIFY",
        "INVESTIGATE"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "confirmed_identity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "configuration_id",
            "human_confirmed"
          ],
          "properties": {
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "configuration_id": {
              "type": "string",
              "minLength": 1
            },
            "human_confirmed": {
              "const": true
            }
          }
        }
      ]
    },
    "manual_label": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "cleared_images": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mime_type": {
            "enum": [
              "image/jpeg",
              "image/png"
            ]
          },
          "cleared_handle": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "image_id",
          "sha256",
          "mime_type",
          "cleared_handle"
        ]
      }
    },
    "approved_catalog": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.mark1.invalid/v2/catalog.schema.json",
      "title": "Approved scoped catalog",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "PREFLIGHT",
                  "OBSERVATION",
                  "EXTERNAL_CHECK"
                ]
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "workflow_id": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "safety_notice": {
                "type": "string",
                "minLength": 1
              },
              "stop_conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "observation_code": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stop_values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "check_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "check_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation_code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allowed_values": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "check_id",
                    "check_version",
                    "observation_code",
                    "allowed_values"
                  ]
                }
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rights_record_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source_id",
                  "version",
                  "sha256",
                  "title",
                  "locator",
                  "rights_record_id"
                ]
              },
              "state": {
                "const": "Approved"
              },
              "approval_record_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "check_id",
              "version",
              "kind",
              "model_id",
              "configuration_id",
              "workflow_id",
              "instruction",
              "safety_notice",
              "stop_conditions",
              "observation_code",
              "options",
              "stop_values",
              "prerequisites",
              "source",
              "state",
              "approval_record_id"
            ]
          }
        },
        "view_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "workflow_id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rights_record_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source_id",
                  "version",
                  "sha256",
                  "title",
                  "locator",
                  "rights_record_id"
                ]
              },
              "state": {
                "const": "Approved"
              },
              "approval_record_id": {
                "type": "string",
                "minLength": 1
              },
              "template_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "safety_notice": {
                "type": "string",
                "minLength": 1
              },
              "stop_conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "purpose": {
                "enum": [
                  "IDENTITY",
                  "INVESTIGATION"
                ]
              },
              "target_node_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "model_id",
              "configuration_id",
              "workflow_id",
              "source",
              "state",
              "approval_record_id",
              "template_id",
              "version",
              "text",
              "safety_notice",
              "stop_conditions",
              "purpose",
              "target_node_id"
            ]
          }
        },
        "question_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "workflow_id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rights_record_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source_id",
                  "version",
                  "sha256",
                  "title",
                  "locator",
                  "rights_record_id"
                ]
              },
              "state": {
                "const": "Approved"
              },
              "approval_record_id": {
                "type": "string",
                "minLength": 1
              },
              "template_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "safety_notice": {
                "type": "string",
                "minLength": 1
              },
              "stop_conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "uniqueItems": true
              }
            },
            "required": [
              "model_id",
              "configuration_id",
              "workflow_id",
              "source",
              "state",
              "approval_record_id",
              "template_id",
              "version",
              "text",
              "safety_notice",
              "stop_conditions",
              "options"
            ]
          }
        },
        "explanation_templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "workflow_id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rights_record_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source_id",
                  "version",
                  "sha256",
                  "title",
                  "locator",
                  "rights_record_id"
                ]
              },
              "state": {
                "const": "Approved"
              },
              "approval_record_id": {
                "type": "string",
                "minLength": 1
              },
              "template_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "safety_notice": {
                "type": "string",
                "minLength": 1
              },
              "stop_conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "advisory": {
                "const": true
              },
              "claim_label": {
                "const": "SUSPECTED"
              },
              "claim_rule": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "check_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "check_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observation_code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allowed_values": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "check_id",
                  "check_version",
                  "observation_code",
                  "allowed_values"
                ]
              },
              "diagram_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "diagram_version": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "allowed_highlight_node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "model_id",
              "configuration_id",
              "workflow_id",
              "source",
              "state",
              "approval_record_id",
              "template_id",
              "version",
              "text",
              "safety_notice",
              "stop_conditions",
              "advisory",
              "claim_label",
              "claim_rule",
              "diagram_id",
              "diagram_version",
              "allowed_highlight_node_ids"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "diagram_id": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "diagram_version": {
                      "type": "null"
                    },
                    "allowed_highlight_node_ids": {
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "diagram_version": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "diagram_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "node_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "node_id",
                    "label",
                    "x",
                    "y"
                  ]
                },
                "minItems": 1,
                "maxItems": 100
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "edge_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from_node_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to_node_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "edge_id",
                    "from_node_id",
                    "to_node_id",
                    "label"
                  ]
                },
                "maxItems": 200
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rights_record_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source_id",
                  "version",
                  "sha256",
                  "title",
                  "locator",
                  "rights_record_id"
                ]
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "workflow_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "const": "Approved"
              },
              "approval_record_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "diagram_id",
              "version",
              "title",
              "nodes",
              "edges",
              "source",
              "model_id",
              "configuration_id",
              "workflow_id",
              "state",
              "approval_record_id"
            ]
          }
        }
      },
      "required": [
        "catalog_version",
        "checks",
        "view_templates",
        "question_templates",
        "explanation_templates",
        "diagrams"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "check_version": {
            "type": "string",
            "minLength": 1
          },
          "observation_code": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "const": "HUMAN_CONFIRMED"
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "check_version",
          "observation_code",
          "value",
          "provenance",
          "record_id"
        ]
      }
    },
    "completed_check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remaining_budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "turns",
        "calls",
        "deadline_at"
      ]
    },
    "model_config_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "investigation_context": {
      "$ref": "investigation.schema.json#/$defs/context"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "session_id",
    "based_on_revision",
    "context_hash",
    "mode",
    "workflow_id",
    "confirmed_identity",
    "manual_label",
    "cleared_images",
    "approved_catalog",
    "observations",
    "completed_check_ids",
    "remaining_budgets",
    "model_config_version",
    "prompt_version",
    "catalog_version",
    "investigation_context"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "INVESTIGATE"
          }
        }
      },
      "then": {
        "properties": {
          "confirmed_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model_id",
              "configuration_id",
              "human_confirmed"
            ],
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "human_confirmed": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "confirmed_identity": {
            "type": "null"
          }
        }
      }
    }
  ]
}
