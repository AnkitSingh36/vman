{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mark1:catalog:1.0",
  "title": "Approved scoped catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "PREFLIGHT",
              "OBSERVATION",
              "EXTERNAL_CHECK"
            ]
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "configuration_id": {
            "type": "string",
            "minLength": 1
          },
          "workflow_id": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "safety_notice": {
            "type": "string",
            "minLength": 1
          },
          "stop_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation_code": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stop_values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1
                },
                "check_version": {
                  "type": "string",
                  "minLength": 1
                },
                "observation_code": {
                  "type": "string",
                  "minLength": 1
                },
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "check_id",
                "check_version",
                "observation_code",
                "allowed_values"
              ]
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "rights_record_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "version",
              "sha256",
              "title",
              "locator",
              "rights_record_id"
            ]
          },
          "state": {
            "const": "Approved"
          },
          "approval_record_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "version",
          "kind",
          "model_id",
          "configuration_id",
          "workflow_id",
          "instruction",
          "safety_notice",
          "stop_conditions",
          "observation_code",
          "options",
          "stop_values",
          "prerequisites",
          "source",
          "state",
          "approval_record_id"
        ]
      }
    }
  },
  "required": [
    "catalog_version",
    "checks"
  ]
}
