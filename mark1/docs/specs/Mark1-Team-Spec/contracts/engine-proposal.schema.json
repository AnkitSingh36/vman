{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mark1.invalid/v2/engine-proposal.schema.json",
  "title": "EngineProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "session_id",
    "based_on_revision",
    "context_hash",
    "kind",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "based_on_revision": {
      "type": "integer",
      "minimum": 0
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "IDENTITY_CANDIDATES",
        "PROPOSE_CHECK",
        "ASK_OBSERVATION",
        "ESCALATE",
        "REQUEST_VIEW",
        "ASK_QUESTION",
        "EXPLAIN"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "version",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PROPOSE_CHECK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "check_version",
              "sources"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "check_version": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "$ref": "#/$defs/sources"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ASK_OBSERVATION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_code",
              "sources",
              "check_id",
              "check_version"
            ],
            "properties": {
              "observation_code": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "check_version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ESCALATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason_code"
            ],
            "properties": {
              "reason_code": {
                "enum": [
                  "INSUFFICIENT_EVIDENCE",
                  "UNSUPPORTED",
                  "CONFLICT",
                  "EXHAUSTED",
                  "MODEL_FAILURE",
                  "BUDGET_EXCEEDED"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "IDENTITY_CANDIDATES"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidates"
            ],
            "properties": {
              "candidates": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "model_id",
                    "configuration_id",
                    "label_excerpt",
                    "basis"
                  ],
                  "properties": {
                    "model_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "configuration_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label_excerpt": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "basis": {
                      "enum": [
                        "IMAGE",
                        "MANUAL"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "REQUEST_VIEW"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "view_template_id": {
                "type": "string",
                "minLength": 1
              },
              "template_version": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "$ref": "#/$defs/sources"
              }
            },
            "required": [
              "view_template_id",
              "template_version",
              "sources"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ASK_QUESTION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question_template_id": {
                "type": "string",
                "minLength": 1
              },
              "template_version": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "$ref": "#/$defs/sources"
              }
            },
            "required": [
              "question_template_id",
              "template_version",
              "sources"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "EXPLAIN"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "explanation_template_id": {
                "type": "string",
                "minLength": 1
              },
              "template_version": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "$ref": "#/$defs/sources"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "highlight_node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "explanation_template_id",
              "template_version",
              "sources",
              "evidence_ids",
              "highlight_node_ids"
            ]
          }
        }
      }
    }
  ]
}
