{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mark1.invalid/v2/session.schema.json",
  "title": "Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "session_id",
    "revision",
    "status",
    "workflow_id",
    "identity",
    "identity_candidates",
    "current_check",
    "receipt",
    "human_reported_outcome",
    "reason_code",
    "interaction"
  ],
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "AWAITING_IDENTITY",
        "EVALUATING",
        "READY",
        "RECORD_PENDING",
        "BLOCKED",
        "UNKNOWN",
        "ESCALATED",
        "COMPLETED",
        "AWAITING_VIEW",
        "AWAITING_ANSWER",
        "EXPLAINING"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/identity"
        }
      ]
    },
    "identity_candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "configuration_id",
          "label_excerpt",
          "basis"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "configuration_id": {
            "type": "string",
            "minLength": 1
          },
          "label_excerpt": {
            "type": "string",
            "maxLength": 160
          },
          "basis": {
            "enum": [
              "IMAGE",
              "MANUAL"
            ]
          }
        }
      }
    },
    "current_check": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/check"
        }
      ]
    },
    "receipt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/receipt"
        }
      ]
    },
    "human_reported_outcome": {
      "enum": [
        null,
        "RESOLVED",
        "UNRESOLVED"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "interaction": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "investigation.schema.json#/$defs/interaction"
        }
      ]
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "configuration_id",
        "human_confirmed"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "human_confirmed": {
          "const": true
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "version",
        "instruction",
        "observation_code",
        "options",
        "source",
        "policy_checked_at",
        "safety_notice",
        "stop_conditions",
        "guidance_valid_until"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "observation_code": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "version",
            "locator"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "policy_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "safety_notice": {
          "type": "string",
          "minLength": 1
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "guidance_valid_until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "state",
        "record_id"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "PENDING",
            "PERSISTED"
          ]
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PERSISTED"
              }
            }
          },
          "then": {
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "PENDING"
              }
            }
          },
          "then": {
            "properties": {
              "record_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "current_check": {
            "$ref": "#/$defs/check"
          },
          "identity": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "else": {
        "properties": {
          "current_check": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "AWAITING_IDENTITY"
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RECORD_PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "allOf": [
              {
                "$ref": "#/$defs/receipt"
              },
              {
                "properties": {
                  "state": {
                    "const": "PENDING"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "human_reported_outcome": {
            "const": "RESOLVED"
          },
          "receipt": {
            "allOf": [
              {
                "$ref": "#/$defs/receipt"
              },
              {
                "properties": {
                  "state": {
                    "const": "PERSISTED"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/receipt"
                  },
                  {
                    "properties": {
                      "state": {
                        "const": "PERSISTED"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "AWAITING_VIEW"
          }
        }
      },
      "then": {
        "properties": {
          "interaction": {
            "allOf": [
              {
                "$ref": "investigation.schema.json#/$defs/interaction"
              },
              {
                "properties": {
                  "kind": {
                    "const": "VIEW"
                  }
                }
              }
            ]
          },
          "receipt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/receipt"
                  },
                  {
                    "properties": {
                      "state": {
                        "const": "PERSISTED"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "AWAITING_ANSWER"
          }
        }
      },
      "then": {
        "properties": {
          "interaction": {
            "allOf": [
              {
                "$ref": "investigation.schema.json#/$defs/interaction"
              },
              {
                "properties": {
                  "kind": {
                    "const": "QUESTION"
                  }
                }
              }
            ]
          },
          "receipt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/receipt"
                  },
                  {
                    "properties": {
                      "state": {
                        "const": "PERSISTED"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXPLAINING"
          }
        }
      },
      "then": {
        "properties": {
          "interaction": {
            "allOf": [
              {
                "$ref": "investigation.schema.json#/$defs/interaction"
              },
              {
                "properties": {
                  "kind": {
                    "const": "EXPLANATION"
                  }
                }
              }
            ]
          },
          "receipt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/receipt"
                  },
                  {
                    "properties": {
                      "state": {
                        "const": "PERSISTED"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "enum": [
                "AWAITING_VIEW",
                "AWAITING_ANSWER",
                "EXPLAINING"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "interaction": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "AWAITING_ANSWER",
              "EXPLAINING"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "AWAITING_VIEW"
          },
          "identity": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "interaction": {
            "properties": {
              "purpose": {
                "const": "IDENTITY"
              }
            }
          }
        }
      }
    }
  ]
}
